# ============================================
# Cú Đầu Tư — Environment Variables
# ============================================
# Copy file này thành `.env.local` và điền giá trị thật.
# Khi deploy lên Cloudflare Pages, set các biến này trong:
# Pages project → Settings → Environment variables

# ---------- Supabase (Optional) ----------
# Lấy từ https://supabase.com → Project Settings → API
# Khi bật, auth + leaderboard + progress sẽ sync lên cloud
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------- AI Tutor (Optional) ----------
# Dùng cho chat AI tài chính
# Tạo API key tại:
#   - OpenAI: https://platform.openai.com/api-keys
#   - Anthropic: https://console.anthropic.com
# LƯU Ý: KHÔNG để key lộ trong client code production.
# Nên dùng Cloudflare Worker làm proxy.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- Analytics (Optional) ----------
# Google Analytics 4 measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Facebook Pixel ID
NEXT_PUBLIC_FB_PIXEL_ID=
